# Maintainer: justforlxz <justforlxz@gmail.com>
pkgname=gxde-dtkgui
pkgver=6.7.43
pkgrel=1
pkgdesc='Deepin Toolkit, gui module for DDE look and feel'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/dtk5gui"
license=('LGPL-3.0-or-later')
# 需要 dtkcommon 6.7.43 的 disableInWindowBlur 配置项；librsvg 由 QLibrary 在运行时加载
# Needs the disableInWindowBlur key from dtkcommon 6.7.43; librsvg is loaded at runtime via QLibrary.
depends=('gxde-dtkcore' 'gxde-dtkcommon>=6.7.43' 'qt5-base' 'qt5-wayland' 'libqt5xdg' 'librsvg' 'glib2' 'libx11')
makedepends=('git' 'cmake' 'ninja' 'qt5-tools' 'extra-cmake-modules' 'treeland-protocols')
provides=("dtkgui=$pkgver" "dtkgui-git=$pkgver")
conflicts=('dtkgui' 'dtkgui-git')
replaces=('dtkgui-git')
groups=('deepin-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  # Arch 已移除 freeimage，因此关闭 RAW 等扩展图片格式支持
  # freeimage is gone from Arch, so disable extended image formats such as RAW.
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DMKSPECS_INSTALL_DIR=lib/qt/mkspecs/modules \
    -DDTK_DISABLE_EX_IMAGE_FORMAT=ON \
    -DBUILD_TESTING=OFF \
    -DBUILD_DOCS=OFF \
    -DDTK5=ON
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
